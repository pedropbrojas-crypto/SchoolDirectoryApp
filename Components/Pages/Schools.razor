@page "/schools"
@using SchoolDirectoryApp.Models
@using SchoolDirectoryApp.Services
@inject SchoolService SchoolService

<PageTitle>School Directory</PageTitle>

<h1>School Directory</h1>

@if (selectedSchool is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h4 card-title">@selectedSchool.SchoolName</h2>
            <p><strong>School ID:</strong> @selectedSchool.SchoolId</p>
            <p><strong>Address:</strong> @selectedSchool.Address</p>
            <p><strong>Phone:</strong> @selectedSchool.PhoneNo</p>
            <p><strong>Email:</strong> @selectedSchool.EmailAddress</p>
            <p><strong>Proprietor:</strong> @selectedSchool.ProprietorFullName</p>
            <p><strong>Head:</strong> @selectedSchool.HeadFullName</p>

            <button class="btn btn-outline-secondary" @onclick="ClearSelection">
                Close details
            </button>
        </div>
    </div>
}

<label for="schoolSearch" class="form-label">Search schools</label>
<input id="schoolSearch"
       class="form-control mb-3"
       @bind="Search"
       @bind:event="oninput"
       placeholder="Search school..." />

@if (isLoading)
{
    <p>Loading schools...</p>
}
else if (hasError)
{
    <p class="text-danger">Unable to retrieve school data.</p>
}
else if (schools.Count == 0)
{
    <p>No schools were found.</p>
}
else if (!FilteredSchools.Any())
{
    <p>No schools match your search.</p>
}
else
{
    <div class="row">
        @foreach (var school in FilteredSchools)
        {
            <div class="col-md-6 col-lg-4 mb-3">
                <SchoolCard School="school" OnSelect="SelectSchool" />
            </div>
        }
    </div>
}

@code {
    private List<School> schools = new();
    private bool isLoading = true;
    private bool hasError;
    private School? selectedSchool;
    private string Search { get; set; } = string.Empty;

    private IEnumerable<School> FilteredSchools =>
        schools.Where(school =>
            (school.SchoolName ?? string.Empty)
                .Contains(Search, StringComparison.OrdinalIgnoreCase));

    private void SelectSchool(School school)
    {
        selectedSchool = school;
    }

    private void ClearSelection()
    {
        selectedSchool = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            schools = await SchoolService.GetSchoolsAsync();
        }
        catch (HttpRequestException)
        {
            hasError = true;
        }
        catch (System.Text.Json.JsonException)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}